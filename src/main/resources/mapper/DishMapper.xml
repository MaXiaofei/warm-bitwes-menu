<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.warmbitwes.menu.mapper.DishMapper">

    <resultMap id="DishDetailMap" type="com.warmbitwes.menu.entity.DishDetail">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="steps" column="steps"/>
        <result property="notes" column="notes"/>
        <result property="durationMin" column="duration_min"/>
        <result property="difficulty" column="difficulty"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <collection property="categories" ofType="com.warmbitwes.menu.vo.DishCategoryLinkVO"
                    notNullColumn="cat_link_category_id">
            <result property="categoryId" column="cat_link_category_id"/>
            <result property="categoryName" column="cat_name"/>
            <result property="sortOrder" column="cat_sort_order"/>
            <result property="remark" column="cat_link_remark"/>
        </collection>
    </resultMap>

    <select id="selectById" parameterType="long" resultMap="DishDetailMap">
        SELECT
            d.id,
            d.name,
            d.cover_url,
            d.steps,
            d.notes,
            d.duration_min,
            d.difficulty,
            d.status,
            d.remark,
            d.created_at,
            d.updated_at,
            dc.category_id AS cat_link_category_id,
            c.name AS cat_name,
            dc.sort_order AS cat_sort_order,
            dc.remark AS cat_link_remark
        FROM dish d
        LEFT JOIN dish_category dc ON dc.dish_id = d.id
        LEFT JOIN category c ON c.id = dc.category_id
        WHERE d.id = #{id}
        ORDER BY dc.sort_order ASC, dc.category_id ASC
    </select>
</mapper>
