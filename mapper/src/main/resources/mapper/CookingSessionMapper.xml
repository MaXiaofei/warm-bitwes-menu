<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.warmbitwes.menu.mapper.CookingSessionMapper">

    <resultMap id="CookingSessionMap" type="com.warmbitwes.menu.entity.CookingSession">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="templateId" column="template_id"/>
        <result property="scene" column="scene"/>
        <result property="flavor" column="flavor"/>
        <result property="crowd" column="crowd"/>
        <result property="status" column="status"/>
        <result property="startedAt" column="started_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.warmbitwes.menu.entity.CookingSession"
            useGeneratedKeys="true" keyProperty="id">
        <!-- 新增做饭会话（返回自增主键 id） -->
        INSERT INTO cooking_session(user_id, template_id, scene, flavor, crowd, status, started_at, remark)
        VALUES (#{userId}, #{templateId}, #{scene}, #{flavor}, #{crowd}, #{status}, #{startedAt}, NULL)
    </insert>

    <select id="selectById" parameterType="long" resultMap="CookingSessionMap">
        <!-- 按主键查询做饭会话 -->
        SELECT id, user_id, template_id, scene, flavor, crowd, status, started_at
        FROM cooking_session
        WHERE id = #{id}
    </select>

    <select id="countByUserId" resultType="long">
        <!-- 统计用户会话数量 -->
        SELECT COUNT(*) FROM cooking_session WHERE user_id = #{userId}
    </select>

    <resultMap id="CookingSessionMineRowMap" type="com.warmbitwes.menu.entity.CookingSessionMineRow">
        <id property="id" column="id"/>
        <result property="templateId" column="template_id"/>
        <result property="templateName" column="template_name"/>
        <result property="startedAt" column="started_at"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="selectMineByUserId" resultMap="CookingSessionMineRowMap">
        <!-- 用户会话分页列表 -->
        SELECT cs.id,
               cs.template_id,
               mt.name AS template_name,
               cs.started_at,
               cs.status
        FROM cooking_session cs
        LEFT JOIN menu_template mt ON mt.id = cs.template_id
        WHERE cs.user_id = #{userId}
        ORDER BY cs.started_at DESC, cs.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>

