<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.warmbitwes.menu.mapper.DishMapper">

    <resultMap id="DishMap" type="com.warmbitwes.menu.entity.Dish">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="steps" column="steps"/>
        <result property="notes" column="notes"/>
        <result property="durationMin" column="duration_min"/>
        <result property="difficulty" column="difficulty"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="DishDetailMap" type="com.warmbitwes.menu.entity.DishDetail">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="steps" column="steps"/>
        <result property="notes" column="notes"/>
        <result property="durationMin" column="duration_min"/>
        <result property="difficulty" column="difficulty"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <collection property="categories" ofType="com.warmbitwes.menu.vo.DishCategoryLinkVO"
                    notNullColumn="cat_link_category_id">
            <result property="categoryId" column="cat_link_category_id"/>
            <result property="categoryName" column="cat_name"/>
            <result property="sortOrder" column="cat_sort_order"/>
            <result property="remark" column="cat_link_remark"/>
        </collection>
    </resultMap>

    <select id="selectById" parameterType="long" resultMap="DishDetailMap">
        <!-- 菜品详情查询：包含分类关联（分类为空则 categories 为空列表） -->
        SELECT
            d.id,
            d.name,
            d.cover_url,
            d.steps,
            d.notes,
            d.duration_min,
            d.difficulty,
            d.status,
            d.remark,
            d.created_at,
            d.updated_at,
            dc.category_id AS cat_link_category_id,
            c.name AS cat_name,
            dc.sort_order AS cat_sort_order,
            dc.remark AS cat_link_remark
        FROM dish d
        LEFT JOIN dish_category dc ON dc.dish_id = d.id
        LEFT JOIN category c ON c.id = dc.category_id
        WHERE d.id = #{id}
          AND d.is_deleted = 0
        ORDER BY dc.sort_order ASC, dc.category_id ASC
    </select>

    <insert id="insert" parameterType="com.warmbitwes.menu.entity.Dish"
            useGeneratedKeys="true" keyProperty="id">
        <!-- 新增菜品（返回自增主键 id） -->
        INSERT INTO dish(name, cover_url, steps, notes, duration_min, difficulty, status, remark)
        VALUES (#{name}, #{coverUrl}, #{steps}, #{notes}, #{durationMin}, #{difficulty}, #{status}, #{remark})
    </insert>

    <select id="selectPage" resultMap="DishMap">
        <!-- 菜品分页查询：过滤软删（is_deleted=0），按 id 倒序 -->
        SELECT id, name, cover_url, steps, notes, duration_min, difficulty, status, remark, created_at, updated_at
        FROM dish
        WHERE is_deleted = 0
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <delete id="deleteIngredientsByDishId" parameterType="long">
        <!-- 删除菜品全部食材关联（用于全量替换） -->
        DELETE FROM dish_ingredient
        WHERE dish_id = #{dishId}
    </delete>

    <insert id="batchInsertDishIngredients">
        <!-- 批量新增菜品食材关联 -->
        INSERT INTO dish_ingredient(dish_id, ingredient_id, amount_g, sort_order, remark)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.dishId}, #{item.ingredientId}, #{item.amountG}, #{item.sortOrder}, NULL)
        </foreach>
    </insert>

    <update id="updateDishBase">
        <!-- 更新菜品基础字段：动态更新，过滤软删 -->
        UPDATE dish
        <set>
            <if test="req.name != null">name = #{req.name},</if>
            <if test="req.coverUrl != null">cover_url = #{req.coverUrl},</if>
            <if test="req.steps != null">steps = #{req.steps},</if>
            <if test="req.notes != null">notes = #{req.notes},</if>
            <if test="req.durationMin != null">duration_min = #{req.durationMin},</if>
            <if test="req.difficulty != null">difficulty = #{req.difficulty},</if>
            <if test="req.status != null">status = #{req.status},</if>
            <if test="req.remark != null">remark = #{req.remark},</if>
        </set>
        WHERE id = #{id}
          AND is_deleted = 0
    </update>

    <update id="updateDishStatus">
        <!-- 更新菜品上下架状态：过滤软删 -->
        UPDATE dish
        SET status = #{status}
        WHERE id = #{id}
          AND is_deleted = 0
    </update>

    <update id="softDelete">
        <!-- 软删除菜品：is_deleted=1 -->
        UPDATE dish
        SET is_deleted = 1
        WHERE id = #{id}
          AND is_deleted = 0
    </update>
</mapper>
